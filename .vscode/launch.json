{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Mini-Courier Planner (Demo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run All (Tests + Benchmarks + Charts)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Medium Dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--dataset",
        "data/medium_courier_dataset.json",
        "--hide-dp-table"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
